DATABASE_URL=file:./walkflow.sqlite
AUTH_SECRET=replace-with-a-strong-random-string
APP_URL=http://localhost:3000
TWILIO_CONVERSATION_RELAY_WSS_URL=ws://localhost:8081/twilio/conversation-relay/ws
# In production set this to a publicly reachable WSS endpoint backed by a persistent websocket server.
TWILIO_RELAY_HOST=0.0.0.0
TWILIO_RELAY_PORT=8081
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional model override for Codex PR code generation.
OPENAI_CODEX_MODEL=gpt-4.1-mini
GITHUB_PROVIDER=rest
GITHUB_READ_TOKEN=
# Optional: narrow read suggestions to specific owners/orgs, comma-separated (e.g. "ricky,my-org")
GITHUB_READ_REPO_OWNERS=
# Optional write path for web app actions only (issue/PR creation), restricted to one repo.
GITHUB_WRITE_TOKEN=
GITHUB_WRITE_ALLOWED_REPO=owner/repo
GITHUB_WRITE_ALLOWED_BASE_BRANCH=main
# Optional PR-on-confirm behavior. Issue creation is always attempted first.
WALKFLOW_ENABLE_AUTO_PR=true
# Enable Codex-generated branch+code for PRs (default true when unset).
WALKFLOW_ENABLE_CODEX_PR=true
# Fallback existing branch name when Codex PR generation is disabled or fails.
WALKFLOW_PR_HEAD_REF=
# MCP mode settings (used when GITHUB_PROVIDER=mcp)
GITHUB_MCP_URL=
GITHUB_MCP_BEARER_TOKEN=
GITHUB_MCP_READ_TOOL=github.search_repositories
GITHUB_MCP_CREATE_ISSUE_TOOL=github.create_issue
GITHUB_MCP_CREATE_PR_TOOL=github.create_pull_request
# Optional local testing overrides for caller mapping:
# If incoming caller matches this phone number, WalkFlow maps to TWILIO_TEST_USER_EMAIL
# (or first user in DB if email is omitted).
TWILIO_TEST_CALLER_E164=
TWILIO_TEST_USER_EMAIL=
