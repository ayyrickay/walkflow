# Required (core app + auth + proposal generation)
DATABASE_URL=file:./walkflow.sqlite
AUTH_SECRET=replace-with-a-long-random-secret
OPENAI_API_KEY=sk-your-openai-api-key

# Required for the dashboard + Twilio voice webhook flow
APP_URL=http://localhost:3000
TWILIO_CONVERSATION_RELAY_WSS_URL=ws://localhost:8081/twilio/conversation-relay/ws

# Required for GitHub repo suggestions and guarded write target
GITHUB_PROVIDER=rest
GITHUB_READ_TOKEN=ghp_your_read_token
GITHUB_WRITE_ALLOWED_REPO=owner/repo

# Nice to have (write automation)
GITHUB_WRITE_TOKEN=ghp_your_write_token
GITHUB_WRITE_ALLOWED_BASE_BRANCH=main
WALKFLOW_ENABLE_AUTO_PR=true
WALKFLOW_ENABLE_CODEX_PR=true
WALKFLOW_PR_HEAD_REF=

# Nice to have (model tuning)
OPENAI_MODEL=gpt-4.1-mini
OPENAI_CODEX_MODEL=gpt-4.1-mini

# Nice to have (narrow repo suggestions to org/user owners)
# Comma-separated, for example: acme-inc,ricky
GITHUB_READ_REPO_OWNERS=

# Nice to have (local relay runtime defaults)
TWILIO_RELAY_HOST=0.0.0.0
TWILIO_RELAY_PORT=8081

# Nice to have (deterministic local caller mapping)
# If caller matches TWILIO_TEST_CALLER_E164, WalkFlow maps to TWILIO_TEST_USER_EMAIL
# (or first user in DB if email is omitted).
TWILIO_TEST_CALLER_E164=+15551234567
TWILIO_TEST_USER_EMAIL=dev@example.com
